flowchart TB
    LOGIN["เข้าสู่ระบบ — Role-based (5 สิทธิ์)"]:::start
    LOGIN --> CREATE["หัวหน้าสร้างใบลา / ใบ OT แทนพนักงาน<br/>เลือกพนักงาน · วันลา หรือ กะ · สายรถ"]:::actor
    CREATE --> CUT{"ผ่าน Cut-off Time ?"}:::dec
    CUT -->|"เกินเวลา"| BLOCK["ถูกระงับ — ติดต่อ HR"]:::cancel
    CUT -->|"ทัน"| SIDE{"พนักงานฝ่ายไหน ?"}:::dec

    SIDE -->|"Office"| O1["ผจก.แผนก · อนุมัติ (Step 1)"]:::navy
    SIDE -->|"Production"| P1["ผจก.แผนก · Step 1"]:::navy
    P1 --> P2["ผจก.โรงงาน · Step 2"]:::navy

    O1 --> DEC{"ผลการพิจารณา"}:::dec
    P2 --> DEC

    DEC -->|"ปฏิเสธ + เหตุผล"| REJ["REJECTED + comment"]:::rej
    DEC -->|"อนุมัติ"| APP["APPROVED — ใบมีผล"]:::ok
    CREATE -. "ยกเลิกก่อนอนุมัติ" .-> CAN["CANCELLED — ไม่หักวันลา"]:::cancel

    APP --> REP["รายงาน + Export Excel → Payroll / KPI"]:::gold
    APP -. "ขอยกเลิกหลังอนุมัติ" .-> HRREV{"HR Review"}:::dec
    HRREV -->|"Reject"| APP
    HRREV -->|"Approve"| CAN2["CANCELLED — คืน Balance"]:::cancel

